{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "preview": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL":"",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY":"",
        "EXPO_PUBLIC_API_URL":""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
